use testcontainers::clients::Cli;
use testcontainers::core::{GenericContainer, WaitFor};
use testcontainers::images::generic::GenericImage;
use testcontainers::Container;

/// Starts the service container.
///
/// This function:
/// 1. Starts the {{name}} service container
/// 2. Waits for the service to print its startup log ("Listening on ...")
/// 3. Returns the container so the caller can stop it when done
pub fn startServiceContainer() -> GenericContainer {
    let docker = Cli::default();

    let service_image = GenericImage::new("{{name}}", "test")
        .with_exposed_port(3000u16)
        .with_env_var("SERVER_PORT", "0.0.0.0:3000")
        .with_wait_for(WaitFor::message_on_stdout("Listening on"));

    service_image.start(&docker)
}
