[package]
name = "{{name}}"
version = "0.1.0"
edition = "2021"
publish = false

[[bin]]
name = "{{name}}"
path = "src/main.rs"

[lib]
name = "{{name}}_lib"
path = "src/lib.rs"

[dependencies]
rusta = "0.1"
rusta-di = "0.1"
rusta-apm = "0.1"
rusta-logger = "0.1"
tokio = { version = "1", features = ["full"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
dotenvy = "0.15"

[dev-dependencies]
testcontainers = "0.23"
reqwest = { version = "0.12", features = ["json"] }
uuid = { version = "1", features = ["v4"] }
