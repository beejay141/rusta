use serde::Deserialize;

#[derive(Debug, Clone, Deserialize)]
pub struct AppConfig {
    pub server_port: String,
}

impl AppConfig {
    pub fn from_env() -> Self {
        Self {
            server_port: std::env::var("SERVER_PORT")
                .unwrap_or_else(|_| "0.0.0.0:3000".to_string()),
        }
    }
}
