[package]
name = "{{name}}"
version = "0.1.0"
edition = "2021"
publish = false

[[bin]]
name = "{{name}}"
path = "src/main.rs"

[lib]
name = "{{name}}_lib"
path = "src/lib.rs"

[dependencies]
rusta = "0.1"
rusta-di = "0.1"
rusta-apm = "0.1"
rusta-logger = "0.1"
tokio = { version = "1", features = ["full"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
mongodb = "3"
jsonwebtoken = "9"
argon2 = { version = "0.5" }
rand = "0.8"
bson = { version = "2", features = ["chrono-0_4"] }
chrono = { version = "0.4", features = ["serde"] }
validator = { version = "0.18", features = ["derive"] }
dotenvy = "0.15"
async-trait = "0.1"
thiserror = "1"

[dev-dependencies]
testcontainers = "0.23"
testcontainers-modules = { version = "0.11", features = ["mongo"] }
reqwest = { version = "0.12", features = ["json"] }
uuid = { version = "1", features = ["v4"] }
