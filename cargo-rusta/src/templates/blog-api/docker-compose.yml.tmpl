services:
  mongo:
    image: mongo:7
    ports:
      - "27017:27017"
    volumes:
      - mongo_data:/data/db
    restart: unless-stopped

  app:
    build:
      context: .
      dockerfile: {{name}}/Dockerfile
    ports:
      - "3000:3000"
    environment:
      - SERVER_PORT=0.0.0.0:3000
      - MONGO_URI=mongodb://mongo:27017
      - MONGO_DB={{name}}
      - JWT_SECRET=change-me-in-production
      - JWT_EXPIRY_SECONDS=3600
    depends_on:
      - mongo
    restart: unless-stopped

volumes:
  mongo_data:
