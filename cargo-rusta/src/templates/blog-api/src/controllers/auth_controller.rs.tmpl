use std::sync::Arc;

use rusta::prelude::*;
use rusta_logger::Logger;

use crate::models::user::{CreateUserDto, LoginDto};
use crate::services::auth_service::AuthService;

#[injectable]
pub struct AuthController {
    #[inject]
    svc: Arc<AuthService>,
    #[inject]
    logger: Arc<Logger>,
}

#[controller("/auth")]
impl AuthController {
    /// POST /auth/register
    #[post("/register")]
    pub async fn register(
        &self,
        ValidatedJson(body, ..): ValidatedJson<CreateUserDto>,
    ) -> Response {
        match self.svc.register(body).await {
            Ok(auth) => Http::created(auth),
            Err(e) => {
                let _ = self.logger.error("Registration failed", None);
                e.into_response()
            }
        }
    }

    /// POST /auth/login
    #[post("/login")]
    pub async fn login(&self, ValidatedJson(body, ..): ValidatedJson<LoginDto>) -> Response {
        match self.svc.login(body).await {
            Ok(auth) => Http::json(auth),
            Err(e) => e.into_response(),
        }
    }
}

pub fn register_controllers(container: &mut rusta::Container) {
    container.register(AuthController::construct(container));
}
